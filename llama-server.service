[Unit]
Description=LLaMA.cpp Server Router
After=network.target
Wants=network.target

[Service]
Type=simple
User=llamabot
WorkingDirectory=/opt/llama.cpp
ExecStart=/opt/llama.cpp/build/bin/llama-server --host 0.0.0.0 --port 8080 --models-preset /var/lib/llama.cpp/config/tharkad.ini --no-ui
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target